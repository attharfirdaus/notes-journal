# Supabase → Project Settings → API (Data API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# The "anon" (legacy) or "publishable" key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" (legacy) or "secret" key. SERVER ONLY. Used by the reminder
# cron and account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Your deployed URL (no trailing slash). Used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push. Generate with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Any long random string; must match the one stored in supabase/cron.sql.
# Generate with:  openssl rand -hex 32
CRON_SECRET=
